# Copy to .env and fill in. .env is git-ignored and must never be committed.
# In GitHub Actions these come from repository secrets and variables instead.

# --- Slack -------------------------------------------------------------------
# Bot token for the renewals error app. Scopes needed:
#   channels:history, groups:history   read #error-alerts (groups: if private)
#   chat:write                         post the daily report
#   channels:read / groups:read        resolve channel metadata
REI_SLACK_BOT_TOKEN=xoxb-...

REI_SOURCE_CHANNEL_ID=C0123456789      # #error-alerts
REI_DEST_CHANNEL_ID=C0987654321        # #error-digest
REI_MENTION_USER_IDS=["U0123456789"]   # JSON list, no angle brackets

# --- Models ------------------------------------------------------------------
REI_ANTHROPIC_API_KEY=sk-ant-...
REI_ANTHROPIC_MODEL=claude-sonnet-5

REI_VOYAGE_API_KEY=pa-...
REI_VOYAGE_MODEL=voyage-3-lite

# --- Behaviour ---------------------------------------------------------------
REI_CLUSTER_THRESHOLD=0.76
REI_LOOKBACK_DAYS=1
REI_ENABLE_DIAGNOSIS=false             # true adds root cause + suggested fix
REI_MAX_QUOTES_INLINE=5
REI_MAX_CLUSTERS_IN_MESSAGE=12
REI_DB_PATH=data/rei.db

# --- Safety ------------------------------------------------------------------
REI_DRY_RUN=false                      # true prints the payload, posts nothing
REI_OFFLINE=false                      # true makes no network calls at all
